\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Ablations on the scientific battery}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Accuracy ablations on the scientific battery (frozen LLaDA-8B). The release combines specialist heads, canonical ordering, and ordinal scoring. Historical, unaligned positional flip figures are not reported.}}{4}{table.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Data scaling does not transfer across domains}{4}{subsection.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Heads retrained on $30\times $ more data from a different QA distribution (qa\_raw corpora) reach near-ceiling in-distribution accuracy but do not transfer to the elite battery, whose questions stress causal/multihop/negation reasoning absent from the source corpus.}}{4}{table.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Public benchmarks}{4}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Backbone and adaptation candidates}{4}{subsection.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Matched frozen/adapted comparison on complete evidence}{4}{subsection.4.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Public-benchmark results for the frozen \texttt  {c\_*} release heads, transcribed from the archived evaluation JSONs rather than earlier rounded summaries. Benchmark data were not used for gradient updates or temperature fitting. Temperatures fitted on elite dev were 0.8274, 2.7127, and 0.9367 for choice, noul, and score. Counts and metrics describe our converted evaluation subsets; third-party results with unverified protocol equivalence are not included as directly comparable rows. Machine-readable values and source hashes are in \texttt  {paper/results.json}.}}{5}{table.3}\protected@file@percent }
\newlabel{tab:public}{{3}{5}{Public-benchmark results for the frozen \texttt {c\_*} release heads, transcribed from the archived evaluation JSONs rather than earlier rounded summaries. Benchmark data were not used for gradient updates or temperature fitting. Temperatures fitted on elite dev were 0.8274, 2.7127, and 0.9367 for choice, noul, and score. Counts and metrics describe our converted evaluation subsets; third-party results with unverified protocol equivalence are not included as directly comparable rows. Machine-readable values and source hashes are in \texttt {paper/results.json}}{table.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Candidate accuracies from the archived JSON reports. Elite sample sizes are 653/1{,}959/1{,}959 for choice/noul/score; public-benchmark sizes match Table~\ref {tab:public}. The frozen $c_*$ heads are retained for release. Head optimization differs between $c_*$ and the other rows, and bw1\_sr is an early-training, shorter-context control. Consequently, this table does not isolate adaptation, model size, or training duration as a cause of the differences.}}{5}{table.4}\protected@file@percent }
\newlabel{tab:candidates}{{4}{5}{Candidate accuracies from the archived JSON reports. Elite sample sizes are 653/1{,}959/1{,}959 for choice/noul/score; public-benchmark sizes match Table~\ref {tab:public}. The frozen $c_*$ heads are retained for release. Head optimization differs between $c_*$ and the other rows, and bw1\_sr is an early-training, shorter-context control. Consequently, this table does not isolate adaptation, model size, or training duration as a cause of the differences}{table.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Accuracy (mean $\pm $ sd over seeds 7331--7333) of the matched frozen/adapted arms on \texttt  {systemone-v2} (identical head recipe, splits, and evaluation per seed). Elite $n$: 448/1{,}200/1{,}218; GPQA main/diamond: 441/193; SciFact: 332 per task. Dev-fitted temperatures for seed 7331: choice 3.39/2.17, noul 1.49/2.78, score 1.27/1.76 (fr/da). Adaptation robustly improves out-of-distribution verification (SciFact noul $+22.6$ points, consistent across seeds, from below the 0.60 majority baseline) at a noisy cost to in-distribution ordinal scoring. This isolates the backbone effect the candidate screen could not, and reverses the sign of the SciFact result observed in the unmatched comparison.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:matched}{{5}{5}{Accuracy (mean $\pm $ sd over seeds 7331--7333) of the matched frozen/adapted arms on \texttt {systemone-v2} (identical head recipe, splits, and evaluation per seed). Elite $n$: 448/1{,}200/1{,}218; GPQA main/diamond: 441/193; SciFact: 332 per task. Dev-fitted temperatures for seed 7331: choice 3.39/2.17, noul 1.49/2.78, score 1.27/1.76 (fr/da). Adaptation robustly improves out-of-distribution verification (SciFact noul $+22.6$ points, consistent across seeds, from below the 0.60 majority baseline) at a noisy cost to in-distribution ordinal scoring. This isolates the backbone effect the candidate screen could not, and reverses the sign of the SciFact result observed in the unmatched comparison}{table.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6}Evidence controls expose option-side leakage}{6}{subsection.4.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Evidence controls on the elite eval split ($n$ per cell 447--1{,}218; shuffle excludes 101 donor-overflow rows). Chance is $\sim $0.25/0.60/0.34 for choice/noul/score (noul majority prior). Controls are scored as agreement with the reference answer under altered evidence, \texttt  {label\_status=evidence\_control}.}}{6}{table.6}\protected@file@percent }
\newlabel{tab:controls}{{6}{6}{Evidence controls on the elite eval split ($n$ per cell 447--1{,}218; shuffle excludes 101 donor-overflow rows). Chance is $\sim $0.25/0.60/0.34 for choice/noul/score (noul majority prior). Controls are scored as agreement with the reference answer under altered evidence, \texttt {label\_status=evidence\_control}}{table.6}{}}
