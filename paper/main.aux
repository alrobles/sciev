\@writefile{toc}{\contentsline {subsection}{\numberline {4.1}Ablations on the scientific battery}{3}{subsection.4.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Ablation on the scientific battery (frozen LLaDA-8B). Canonical ordering eliminates order sensitivity exactly; per-type specialist heads plus AttnPool give the best choice accuracy and automation.}}{3}{table.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.2}Data scaling does not transfer across domains}{3}{subsection.4.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3}Public benchmarks}{3}{subsection.4.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5}Discussion}{3}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{What a decision layer buys.}{3}{section*.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Heads retrained on $30\times $ more data from a different QA distribution (qa\_raw corpora) reach near-ceiling in-distribution accuracy but do not transfer to the elite battery, whose questions stress causal/multihop/negation reasoning absent from the source corpus.}}{4}{table.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Zero-shot transfer to public benchmarks (eval-only; temperature fitted on the battery dev split, no benchmark data seen). Published System-One numbers are third-party measurements (Kumar, 2026) on identical public datasets. GPQA accuracy sits at the reported backbone ceiling (LLaDA-8B $\approx $0.33), indicating the readout already extracts the backbone's accessible parametric knowledge. Transfer to $K{\le }4$ classification is strong (SST-2, AG News); $K{=}77$ degrades because training used $K{\le }4$.}}{4}{table.3}\protected@file@percent }
